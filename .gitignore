# Dependencies
node_modules/
.pnpm-store/

# Build output
dist/
build/
coverage/
*.tsbuildinfo
.turbo/
.vitest/

# Environment & secrets: never commit real env files
.env
.env.*
!.env.example
*.pem
*.key

# Docker: Strutvane repos never commit Docker files (ADR-0006; ADR-0021 lets generated apps opt in, not us)
docker/
Dockerfile*
.dockerignore
compose.yaml
compose.*.yaml
docker-compose*.yml
docker-compose*.yaml

# Logs & OS / editor files
# Anchored to the repo root: a bare "logs/" also ignored any nested logs folder (e.g. a package
# or source folder named logs), so new files there were silently never added (dry run B1).
/logs/
*.log
npm-debug.log*
pnpm-debug.log*
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json

# Claude Code: personal, machine-local settings
.claude/settings.local.json
