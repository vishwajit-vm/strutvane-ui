# Managed by strutvane-tooling (canonical/.npmrc). Do not edit in package repos: change it in
# strutvane-tooling and run `npm run sync` there. Never put tokens or registry credentials here.
#
# npm supply-chain guards (npm >= 11.19). They replace the pnpm-workspace.yaml guards
# (allowBuilds + minimumReleaseAge) that left with pnpm (hub docs/18 §7, dry run B11).
#
# npm silently ignores settings it does not know, so an older npm would drop every guard below.
# Each repo's package.json must therefore pin the package manager (it is not synced, because
# package.json is the repo's own file):
#
#   "devEngines": {
#     "packageManager": { "name": "npm", "version": ">=11.19.0", "onFail": "error" }
#   }
#
# and must NOT keep a pnpm "packageManager" field. CI installs npm 11.19.0 itself.

# Dependency install scripts run only when approved in package.json "allowScripts" (pinned
# pkg@version entries, written with `npm approve-scripts <pkg>`; `false` records a refusal, e.g.
# "fsevents@2.3.3": false). Any other install script fails the install instead of running: a
# compromised dependency can't execute code on `npm ci`.
strict-allow-scripts=true

# Third-party versions must be at least one day old before they can be installed (pnpm's default
# minimumReleaseAge): most malicious releases are caught and unpublished within hours. Our own
# versions are staged and approved with 2FA (ADR-0018), so they are exempt; otherwise every
# dependent would wait a day after each framework release.
min-release-age=1
min-release-age-exclude[]=@strutvane/*

# No dependencies from git URLs: they bypass the registry's integrity, provenance and
# min-release-age checks (check-deps.mjs also refuses non-registry lockfile entries).
allow-git=none

# The Node version in package.json "engines" is enforced, so an unsupported Node fails the
# install instead of failing later in confusing ways.
engine-strict=true
